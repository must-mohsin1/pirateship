# AWS ECS/Fargate rehearsal configuration for the checked-in Polygon Amoy contract.
# Copy to an ignored .env.aws file only for local Docker testing. In ECS, inject
# RPC_URL and ADMIN_TOKEN from AWS Secrets Manager instead of committing values.
NODE_ENV=production
RPC_URL=https://YOUR_DEDICATED_POLYGON_AMOY_RPC
CONTRACT_ADDRESS=0x6bF097816997C242F3447A470d1cc3d170cbcB98
PUBLIC_ORIGIN=https://YOUR_AWS_PUBLIC_HOST
CORS_ORIGIN=
ADMIN_TOKEN=
RPC_TIMEOUT_MS=10000
VERIFICATION_MAX_CONCURRENT=8
VERIFICATION_MAX_QUEUED=32
PORT=4173
HOST=0.0.0.0
DATABASE_PATH=/data/product-keys.db
# Safe only when the task port accepts traffic exclusively from the AWS ALB.
TRUST_PROXY=true
