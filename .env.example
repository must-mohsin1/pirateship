# Polygon mainnet product-key service. Do not deploy before audit and governance review.
RPC_URL=https://YOUR_DEDICATED_POLYGON_RPC
CONTRACT_ADDRESS=
PUBLIC_ORIGIN=https://YOUR_PUBLIC_HTTPS_ORIGIN
CORS_ORIGIN=
ADMIN_TOKEN=
PRODUCT_KEY_MODE=generated
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PRODUCT_KEY_ENCRYPTION_KEY=
PRODUCT_KEY_GENERATION_KEY=
# Leave blank to use the safe default namespace containing CONTRACT_ADDRESS.
PRODUCT_KEY_REDIS_PREFIX=
PRODUCT_KEY_LICENSE_PREFIX=PIRATE-POL
REDIS_TIMEOUT_MS=5000
RPC_TIMEOUT_MS=10000
VERIFICATION_MAX_CONCURRENT=8
VERIFICATION_MAX_QUEUED=32
PORT=4173
HOST=127.0.0.1
# Required for the documented HTTPS reverse-proxy deployment. The service must not be directly reachable.
TRUST_PROXY=true
