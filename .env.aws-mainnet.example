# AWS application configuration for Polygon mainnet after contract deployment.
# No CDK changes are required. DevOps injects the blank runtime values through
# the deployment environment and must not commit the populated file.
NODE_ENV=production
RPC_URL=https://YOUR_DEDICATED_POLYGON_MAINNET_RPC
CONTRACT_ADDRESS=
EXPECTED_CHAIN_ID=137
PUBLIC_ORIGIN=https://pirateship.must.company
CORS_ORIGIN=
ADMIN_TOKEN=
RPC_TIMEOUT_MS=10000
VERIFICATION_MAX_CONCURRENT=8
VERIFICATION_MAX_QUEUED=32
HEALTH_CHECK_TTL_MS=10000
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=60
PORT=4173
HOST=0.0.0.0
TRUST_PROXY=true

# Unlimited, stable product keys backed by shared Redis state. REDIS_URL must be
# a TLS/authenticated, non-cluster primary/write endpoint reachable from ECS,
# for example rediss://default:URL_ENCODED_PASSWORD@PRIMARY_ENDPOINT:6379.
# Inject the complete URL through the deployment secret manager; never commit it.
# Generate the two 32-byte secrets independently. Never reuse Amoy credentials
# or namespaces.
PRODUCT_KEY_MODE=generated
REDIS_URL=
REDIS_CLUSTER_MODE=false
PRODUCT_KEY_ENCRYPTION_KEY=
PRODUCT_KEY_GENERATION_KEY=
# Leave blank to use the safe default namespace containing CONTRACT_ADDRESS.
PRODUCT_KEY_REDIS_PREFIX=
PRODUCT_KEY_LICENSE_PREFIX=PIRATE-POL
REDIS_TIMEOUT_MS=5000
