# Read-only Polygon mainnet readiness check. Copy to .env.mainnet-preflight.
# This file never accepts a seed phrase or private key and cannot deploy a contract.
RPC_URL=https://YOUR_DEDICATED_POLYGON_RPC
DEPLOYER_ADDRESS=
BENEFICIARY_ADDRESS=
MINIMUM_PLEDGE_POL=250
OWNER_CUSTODY_MODE=
SECURITY_AUDIT_COMPLETE=no
AUDIT_REPORT_URL=
PRICE_REVIEW_COMPLETE=no
RELEASE_CRITERIA_URL=
SOURCE_COMMIT=
