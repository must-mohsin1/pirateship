# Read-only Polygon mainnet readiness check for the approved campaign settings.
# Copy to .env.mainnet-preflight after independently verifying the owner wallet on Polygon.
# This file never accepts a seed phrase or private key and cannot deploy a contract.
RPC_URL=https://YOUR_DEDICATED_POLYGON_RPC
DEPLOYER_ADDRESS=0xcF9178cA7360066B25de9c142A4c155abf151D6f
BENEFICIARY_ADDRESS=0xcF9178cA7360066B25de9c142A4c155abf151D6f
MINIMUM_PLEDGE_POL=300
OWNER_CUSTODY_MODE=trust-wallet-eoa
# Set both to yes only after the owner explicitly accepts permanent hot-wallet custody
# and confirms an offline recovery backup. Never place the recovery phrase in this file.
HOT_WALLET_RISK_ACCEPTED=no
WALLET_RECOVERY_BACKUP_CONFIRMED=no
SECURITY_AUDIT_COMPLETE=no
AUDIT_REPORT_URL=
# Set to yes only after an authorized business approver accepts the immutable POL price.
PRICE_REVIEW_COMPLETE=no
RELEASE_CRITERIA_URL=https://pirateship.must.company/mainnet-release-criteria.html
SOURCE_COMMIT=
